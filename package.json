{
  "name": "iodine",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=server\" \"npm run dev --workspace=client\"",
    "build": "npm run build --workspace=server && npm run build --workspace=client",
    "test": "npm run test --workspace=client",
    "typecheck": "npm run typecheck --workspace=client && npm run typecheck --workspace=server",
    "postinstall": "node -e \"const fs=require('fs');for(const p of ['node_modules/node-pty/prebuilds/darwin-x64/spawn-helper','node_modules/node-pty/prebuilds/darwin-arm64/spawn-helper']){try{fs.chmodSync(p,0o755)}catch{}}\""
  },
  "devDependencies": {
    "concurrently": "^8.2.0"
  }
}
