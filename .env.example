# Anthropic Claude — https://console.anthropic.com
# Also auto-detected from ~/.anthropic/api_key (e.g. if Claude Code is installed)
ANTHROPIC_API_KEY=

# OpenAI — https://platform.openai.com/api-keys
OPENAI_TOKEN=

# Google Gemini — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Rollout switch for terminal command auto-approval. Off unless set to 1.
# While off, matched rules are logged to ~/.iodine/<workspace>/approval-log.jsonl
# but you are still asked every time. Read that log before turning this on.
IODINE_AUTO_APPROVE=
