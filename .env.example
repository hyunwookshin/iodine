# Anthropic Claude — https://console.anthropic.com
# Also auto-detected from ~/.anthropic/api_key (e.g. if Claude Code is installed)
ANTHROPIC_API_KEY=

# Optional OpenAI chat provider. Command embeddings run locally without this key.
OPENAI_TOKEN=

# Google Gemini — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Optional compatibility switch for older saved approval rules.
# New rules saved with Always allow take effect without this setting.
IODINE_AUTO_APPROVE=
